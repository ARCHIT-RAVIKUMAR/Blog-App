# Optional. Point at a mockapi.io resource, e.g. https://xxxx.mockapi.io/api/v1/posts
# If unset, the app serves the bundled seed data through its own /api/posts route.
MOCK_API_URL=

# Public site URL, used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
